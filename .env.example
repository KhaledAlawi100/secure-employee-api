# ==========================
# Database Configuration
# ==========================
POSTGRES_DB=secure_employee_db
POSTGRES_USER=secure_employee
POSTGRES_PASSWORD=secure_employee_password
DB_URL=jdbc:postgresql://postgres:5432/secure_employee_db

# ==========================
# JWT
# ==========================
JWT_SECRET=your-very-long-secret-key
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_ISSUER=secure-employee-api

# ==========================
# Refresh Tokens
# ==========================
REFRESH_TOKEN_EXPIRATION=604800000
REFRESH_TOKEN_ROTATION_ENABLED=true
REFRESH_TOKEN_MAX_DEVICES=5
REFRESH_TOKEN_REUSE_DETECTION=true
REFRESH_TOKEN_REVOKE_ON_PASSWORD_CHANGE=true
REFRESH_TOKEN_CLEANUP_CRON=0 0 2 * * *

# ==========================
# Admin User
# ==========================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# ==========================
# Google OAuth2
# ==========================
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret